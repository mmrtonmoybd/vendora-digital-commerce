{
    "name": "mmrtonmoybd/vendora-digital-commerce",
    "description": "A manually-fulfilled digital-products storefront and back office: wallet, coupons, affiliates, tickets and access-grant delivery, priced in integer paisa and served bilingually in Bengali and English.",
    "keywords": [
        "laravel",
        "filament",
        "ecommerce",
        "digital-products",
        "bangladesh",
        "shurjopay",
        "bengali",
        "litespeed"
    ],
    "license": "proprietary",
    "homepage": "https://github.com/mmrtonmoybd/vendora-digital-commerce",
    "authors": [
        {
            "name": "Moshiur Rahman",
            "email": "rmedha037@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "rmedha037@gmail.com",
        "issues": "https://github.com/mmrtonmoybd/vendora-digital-commerce/issues"
    },
    "type": "project",
    "$schema": "https://getcomposer.org/schema.json",
    "require": {
        "php": "^8.3",
        "awcodes/overlook": "^4.0",
        "bezhansalleh/filament-shield": "^4.1",
        "caresome/filament-auth-designer": "^3.0",
        "charrafimed/global-search-modal": "^5.0",
        "dutchcodingcompany/filament-developer-logins": "^2.1",
        "filament/filament": "^5.2",
        "jeffgreco13/filament-breezy": "^3.1",
        "laravel/fortify": "^1.40",
        "laravel/framework": "^13.17",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "litespeed/lscache-laravel": "^2.0",
        "maatwebsite/excel": "^4.0",
        "mews/purifier": "^3.4",
        "mpdf/mpdf": "^8.2",
        "northwestern-sysdev/northwestern-filament-theme": "^2.3",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-sitemap": "^8.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": "pint",
        "lint:test": "pint --test",
        "stan": "phpstan analyse --memory-limit=2G",
        "parity": "@php scripts/check-classes.php",
        "test:all": [
            "@lint:test",
            "@stan",
            "@parity",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
